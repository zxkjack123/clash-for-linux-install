# 网络监控系统 - 环境变量配置模板
# 
# 使用方法:
#   1. 复制此文件: cp .env.example .env
#   2. 编辑 .env 文件，填入你的真实 API keys
#   3. .env 文件已添加到 .gitignore，不会被提交到 Git
#
# 注意: 所有脚本会自动加载 .env 文件中的配置

# ========================================
# API Keys 配置
# ========================================

# SCNET LLM 配置 (必填)
# 用途: 运行 test_scnet_api.sh 以及网络健康检查中的 SCNET 项
# 获取: 联系曙光 SCNET 后台
# 默认 API 地址: https://api.scnet.cn/api/llm/v1/chat/completions
SCNET_BASE_URL="https://api.scnet.cn/api/llm/v1/chat/completions"
SCNET_API_KEY=""
SCNET_MODEL="DeepSeek-R1-671B"

# UIUI API Key (可选)
# 用途: 用于测试 UIUI API 的连接性
# 获取地址: https://sg.uiuiapi.com
UIUI_API_KEY=""

# OpenRouter API Key (可选)
# 用途: 检查 openrouter.ai 服务可用性 (所有脚本默认访问 https://openrouter.ai/api/v1/*)
# 官方文档: https://openrouter.ai/api
OPENROUTER_API_KEY=""

# 硅基流动 API Key (可选)
# 用途: 用于测试硅基流动 API 的连接性
# 获取地址: https://cloud.siliconflow.cn/account/ak
# 示例: SILICONFLOW_API_KEY="sk-xxxxxxxxxxxxxxxx"
SILICONFLOW_API_KEY=""

# ========================================
# 通知配置 (可选)
# ========================================

# Webhook 通知地址
# 用途: 当网络出现异常时，发送 Webhook 通知
# 示例: WEBHOOK_URL="https://your-webhook-url.com/notify"
# WEBHOOK_URL=""

# Email 通知配置
# 用途: 发送邮件告警
# EMAIL_TO=""
# EMAIL_FROM=""
# SMTP_SERVER=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""

# ========================================
# Clash/Mihomo 配置
# ========================================

# Clash API 地址 (默认: http://127.0.0.1:9090)
# CLASH_API="http://127.0.0.1:9090"

# Clash API Secret (如果启用了 API 认证)
# API_SECRET=""

# HTTP 代理地址 (默认: http://127.0.0.1:7890)
# PROXY="http://127.0.0.1:7890"

# ========================================
# 调试选项
# ========================================

# 详细日志模式 (0=关闭, 1=开启)
# VERBOSE=0
