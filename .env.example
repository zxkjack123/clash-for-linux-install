# 网络监控系统 - 环境变量配置模板
# 
# 使用方法:
#   1. 复制此文件: cp .env.example .env
#   2. 编辑 .env 文件，填入你的真实 API keys
#   3. .env 文件已添加到 .gitignore，不会被提交到 Git
#
# 注意: 所有脚本会自动加载 .env 文件中的配置

# ========================================
# API Keys 配置
# ========================================

# SCNET LLM 配置 (必填)
# 用途: 运行 test_scnet_api.sh 以及网络健康检查中的 SCNET 项
# 获取: 联系曙光 SCNET 后台
# 默认 API 地址: https://api.scnet.cn/api/llm/v1/chat/completions
SCNET_BASE_URL="https://api.scnet.cn/api/llm/v1/chat/completions"
SCNET_API_KEY=""
SCNET_MODEL="DeepSeek-R1-671B"

# UIUI API Key (可选)
# 用途: 用于测试 UIUI API 的连接性
# 获取地址: https://sg.uiuiapi.com
UIUI_API_KEY=""

# OpenRouter API Key (可选)
# 用途: 检查 openrouter.ai 服务可用性 (所有脚本默认访问 https://openrouter.ai/api/v1/*)
# 官方文档: https://openrouter.ai/api
OPENROUTER_API_KEY=""

# 硅基流动 API Key (可选)
# 用途: 用于测试硅基流动 API 的连接性
# 获取地址: https://cloud.siliconflow.cn/account/ak
# 示例: SILICONFLOW_API_KEY="sk-xxxxxxxxxxxxxxxx"
SILICONFLOW_API_KEY=""

# ========================================
# 通知配置 (可选)
# ========================================

# Webhook 通知地址
# 用途: 当网络出现异常时，发送 Webhook 通知
# 示例: WEBHOOK_URL="https://your-webhook-url.com/notify"
# WEBHOOK_URL=""

# Email 通知配置
# 用途: 发送邮件告警
# EMAIL_TO=""
# EMAIL_FROM=""
# SMTP_SERVER=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""

# ========================================
# Clash/Mihomo 配置
# ========================================

# Controller API 地址 (可选)
# - 默认多数脚本会从 ~/.local/share/clash/runtime.yaml 自动探测 external-controller
# - 只有在你需要覆盖自动探测结果时才设置它
# 示例: CLASH_API="http://127.0.0.1:9090"
# （兼容/历史）某些配置可能使用 9990 端口：CLASH_API="http://127.0.0.1:9990"

# Controller Secret / API 认证 (可选)
# - 当 runtime.yaml 中启用了 `secret` 时，访问 controller API 需要 Authorization header
# - 多数脚本会从 runtime.yaml 自动读取 secret；如需手动覆盖可设置此变量
# 推荐变量名:
CLASH_SECRET=""
# 兼容旧变量名（不要同时使用，优先 CLASH_SECRET）：
# CLASH_API_SECRET=""
# API_SECRET=""

# 订阅地址 (可选)
# - 仅用于你想通过脚本/自动化写入订阅 URL 的场景
CLASH_SUBSCRIPTION_URL=""

# HTTP 代理地址 (可选)
# - 默认本项目假设本地代理为 http://127.0.0.1:7890
# PROXY="http://127.0.0.1:7890"

# SiliconFlow 探测 URL 覆盖 (可选)
# - 用途: network_health_monitor.sh 中 “硅基流动” 站点可达性探测
# - 默认: https://siliconflow.cn/
# - 如果该站点域名/跳转策略变化，可用 vpn-tools/test_siliconflow_api.sh 找到可达 URL，再在此覆盖
SILICONFLOW_URL="https://siliconflow.cn/"

# ========================================
# 调试选项
# ========================================

# 详细日志模式 (0=关闭, 1=开启)
# VERBOSE=0
