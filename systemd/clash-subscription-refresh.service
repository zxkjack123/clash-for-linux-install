[Unit]
Description=Refresh Clash subscription (proxy-clean)
After=default.target network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/clash
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/snap/bin
Environment=RUN_OPTIMIZE_AFTER_REFRESH=1
Environment=OPTIMIZE_DELAY=900
Environment=OPTIMIZE_SCRIPT=%h/.local/share/clash/vpn-tools/optimize_all_network.sh
ExecStart=%h/.local/share/clash/script/refresh_subscription_direct.sh
Restart=on-failure
RestartSec=300
StartLimitIntervalSec=3600
StartLimitBurst=3
# Optional: adjust timeout if provider is slow
TimeoutStartSec=45min
